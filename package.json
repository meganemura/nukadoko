{
  "name": "nukadoko",
  "version": "0.9.0",
  "description": "Typed step contracts for Gherkin, so a scenario can be told wrong before it runs. The vocabulary is machine-readable for agents, and every execution leaves a step record the tool measured rather than the agent reported.",
  "type": "module",
  "bin": {
    "nuka": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js"
    },
    "./matching": {
      "types": "./dist/matching/index.d.ts",
      "import": "./dist/matching/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "test": "npm run build && vitest run",
    "selftest": "npm run build && node selftest-suite/run-selftest.mjs",
    "prepublishOnly": "npm run build",
    "coverage": "npm run build && vitest run --coverage",
    "pack-check": "npm run build && node scripts/pack-check.mjs"
  },
  "keywords": [
    "cucumber",
    "cucumber-js",
    "gherkin",
    "bdd",
    "playwright",
    "e2e-testing",
    "acceptance-testing",
    "test-automation",
    "typescript",
    "static-analysis",
    "ai-agents",
    "agent-skills",
    "allure"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meganemura/nukadoko.git"
  },
  "homepage": "https://github.com/meganemura/nukadoko#readme",
  "author": "meganemura",
  "license": "MIT",
  "files": [
    "CHANGELOG.md",
    "dist",
    "docs",
    "skills",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "20.0.0",
    "@cucumber/gherkin": "42.0.0",
    "@cucumber/messages": "34.2.0",
    "allure-js-commons": "3.10.2",
    "playwright": "1.61.1",
    "tsx": "4.23.1",
    "yargs": "18.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.0",
    "@cucumber/junit-xml-formatter": "0.14.0",
    "@hegeldev/hegel": "0.4.5",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "26.1.1",
    "@types/yargs": "17.0.35",
    "@vitest/coverage-v8": "4.1.10",
    "allure": "3.14.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
