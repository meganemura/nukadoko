{
  "name": "nukadoko",
  "version": "0.0.3",
  "description": "A living pickling bed for your Gherkin: typed steps, receipts, and an agent-first CLI.",
  "type": "module",
  "bin": {
    "nuka": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cucumber",
    "cucumber-js",
    "gherkin",
    "bdd",
    "playwright",
    "e2e-testing",
    "acceptance-testing",
    "test-automation",
    "typescript",
    "zod",
    "ai-agents",
    "agent-skills",
    "allure"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meganemura/nukadoko.git"
  },
  "homepage": "https://github.com/meganemura/nukadoko#readme",
  "author": "meganemura",
  "license": "MIT",
  "files": [
    "CHANGELOG.md",
    "dist",
    "docs",
    "skills",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "20.0.0",
    "@cucumber/gherkin": "42.0.0",
    "@cucumber/messages": "34.2.0",
    "allure-js-commons": "3.10.2",
    "playwright": "1.61.1",
    "tsx": "4.23.1",
    "yargs": "18.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cucumber/junit-xml-formatter": "0.14.0",
    "@types/node": "26.1.1",
    "@types/yargs": "17.0.35",
    "allure": "3.14.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
