{
  "name": "nukadoko",
  "version": "0.0.0",
  "description": "A living pickling bed for your Gherkin: typed steps, receipts, and an agent-first CLI.",
  "type": "module",
  "bin": {
    "nuka": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "gherkin",
    "cucumber",
    "bdd",
    "acceptance-testing",
    "playwright",
    "typed-step",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meganemura/nukadoko.git"
  },
  "homepage": "https://github.com/meganemura/nukadoko#readme",
  "author": "meganemura",
  "license": "MIT",
  "files": [],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "20.0.0",
    "@cucumber/gherkin": "42.0.0",
    "playwright": "1.61.1",
    "tsx": "4.23.1",
    "yargs": "18.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/yargs": "17.0.35",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
