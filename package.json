{
  "name": "nukadoko",
  "version": "0.20.0",
  "description": "Typed step contracts for Gherkin, so a scenario can be told wrong before it runs. Every execution leaves a step record the tool measured rather than the agent reported, and every run a Markdown summary that is the run's evidence.",
  "type": "module",
  "bin": {
    "nuka": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js"
    },
    "./matching": {
      "types": "./dist/matching/index.d.ts",
      "import": "./dist/matching/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/guard-playwright-types.ts dist",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "archstrict": "archstrict check",
    "test": "npm run build && vitest run",
    "selftest": "npm run build && node selftest-suite/run-selftest.mjs",
    "prepublishOnly": "npm run build",
    "coverage": "npm run build && vitest run --coverage",
    "pack-check": "npm run build && node scripts/pack-check.mjs",
    "skill-examples": "npm run build && node scripts/skill-examples.ts"
  },
  "keywords": [
    "cucumber",
    "cucumber-js",
    "gherkin",
    "bdd",
    "playwright",
    "e2e-testing",
    "acceptance-testing",
    "test-automation",
    "typescript",
    "static-analysis",
    "ai-agents",
    "agent-skills",
    "allure"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meganemura/nukadoko.git"
  },
  "homepage": "https://github.com/meganemura/nukadoko#readme",
  "author": "meganemura",
  "license": "MIT",
  "files": [
    "CHANGELOG.md",
    "dist",
    "docs",
    "skills",
    "src",
    "llms.txt"
  ],
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "20.0.0",
    "@cucumber/gherkin": "42.0.0",
    "@cucumber/messages": "34.2.0",
    "allure-js-commons": "3.10.2",
    "yargs": "18.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.0",
    "@cucumber/junit-xml-formatter": "0.14.0",
    "@hegeldev/hegel": "0.4.5",
    "@meganemura/depug": "0.1.3",
    "@types/node": "26.1.1",
    "@types/yargs": "17.0.35",
    "@vitest/coverage-v8": "4.1.11",
    "allure": "3.14.3",
    "archstrict": "0.5.0",
    "playwright": "1.61.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "playwright": "^1.61.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "adm-zip": "0.6.1",
    "axios": "1.20.0",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.16",
    "markdown-it": "14.3.2",
    "postcss": {
      "nanoid": "3.3.18"
    },
    "source-map-js": "1.2.2"
  }
}
