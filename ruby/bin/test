#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs every test file under test/, or the files named.
$LOAD_PATH.unshift File.expand_path("../lib", __dir__), File.expand_path("../test", __dir__)
files = ARGV.empty? ? Dir[File.expand_path("../test/**/*_test.rb", __dir__)].sort : ARGV.map { File.expand_path(_1) }
require "minitest/autorun"
files.each { require _1 }
