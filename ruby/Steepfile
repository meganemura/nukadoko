# frozen_string_literal: true

# The type check of the engine itself: lib/ against the signatures
# rbs-inline writes from its comments (sig/generated), what rbs-inline
# cannot write (sig/nukadoko.rbs), and hand-written stubs of the gems that
# ship no signature (sig-deps, not in the gem).
D = Steep::Diagnostic

target :lib do
  check "lib"
  signature "sig", "sig-deps"

  library "digest", "fileutils", "ipaddr", "json", "net-http", "open3", "pathname", "securerandom", "shellwords", "socket",
          "time", "timeout", "tmpdir", "uri", "zlib", "prism"

  configure_code_diagnostics(D::Ruby.default) do |hash|
    # Most values here are JSON a step returned, so an empty [] or {} has no
    # element type worth naming; a warning on each would hide the ones that
    # say something.
    hash[D::Ruby::UnannotatedEmptyCollection] = nil
    # Steep reports a node it cannot type as UnexpectedError and skips the
    # rest of that node. The default level is hint, so the check would pass.
    hash[D::Ruby::UnexpectedError] = :error
  end
end
