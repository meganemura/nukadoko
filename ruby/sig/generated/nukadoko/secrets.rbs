      # : (*untyped) -> Integer
      def write: (*untyped) -> Integer

      # : (*untyped) -> nil
      def puts: (*untyped) -> nil

      # : (*untyped) -> nil
      def print: (*untyped) -> nil

      # : (String, *untyped) -> nil
      def printf: (String, *untyped) -> nil

      # : (untyped) -> self
      def <<: (untyped) -> self

      # : () -> self
      def flush: () -> self

      # : () -> bool
      def sync: () -> bool

      # : (bool) -> bool
      def sync=: (bool) -> bool

      # : () -> bool
      def tty?: () -> bool
    end
  end
