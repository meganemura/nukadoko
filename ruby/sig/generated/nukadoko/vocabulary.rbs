    # : (singleton(Step), Array[singleton(Step)]) -> Hash[Symbol, untyped]
    def self.states: (singleton(Step), Array[singleton(Step)]) -> Hash[Symbol, untyped]

    # : (singleton(Step)) -> Hash[untyped, untyped]?
    def self.from: (singleton(Step)) -> Hash[untyped, untyped]?

