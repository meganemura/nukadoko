      # : (untyped) -> String
      def self?.value_text: (untyped) -> String

      # : (String) -> Hash[Symbol, untyped]
      def self?.term_of: (String) -> Hash[Symbol, untyped]

      # Why a field cannot be read on a kind's lines, or nil.
      # : (String, String) -> String?
      def self?.field_problem: (String, String) -> String?

      # A term as a path's key reads it: an `http` origin on loopback
