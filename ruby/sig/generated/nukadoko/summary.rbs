      MARKER: ::String

      # A failed scenario is its cell, and a row with no required cell is
      # its reason line, so the findings list leaves those out.
      TABLE_CODES: untyped

      RED: untyped

      VALUE_TEXT_LIMIT: ::Integer

      STDOUT_JSON_LIMIT: ::Integer

      ANSI: ::Regexp

      THROW_LOCATION: ::Regexp

      CARETS: ::Regexp

      CLAIMS_LEAD: ::String

      CONTROL_NOTE: ::String

      LIMIT_KINDS: untyped

      LIMIT_HEADINGS: untyped

      def self?.render: (untyped doc) -> untyped

      # Text outside a code span: `\` doubled first, so the `\` before a
      # `|` survives both the table parser and the inline one, and `<`
      # never opens a tag.
      def self?.cell_text: (untyped text) -> untyped

      # A code span longer than any backtick run inside it.
