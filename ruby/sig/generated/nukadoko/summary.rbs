      def self?.markdown_link: (untyped label, untyped href) -> untyped

      def self?.seen_text: (untyped links) -> untyped

      def self?.seen_column: (untyped doc) -> untyped

      def self?.reasons: (untyped doc) -> untyped

      # Where an execution stopped: the step, the error's first line, the
