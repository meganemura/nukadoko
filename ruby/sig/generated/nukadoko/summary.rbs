      def self?.count_of: (untyped count, untyped one, untyped many) -> untyped

      def self?.duration: (untyped ms) -> untyped

      def self?.value_text: (untyped value) -> untyped

      # The first line with text in it; a Node throw location with its
      # source line and carets is skipped, and a line that ends in a colon
