# Generated from lib/nukadoko/summary.rb with RBS::Inline

# summary.md: the run as a person reads it, rendered from run.json alone,
# in the TypeScript engine's words, so a summary never says something
# run.json does not and `nuka report` renders the same file again from a
# run.json copied off another machine. The sections this engine has no
# field for yet (removed criteria, paths, flags, routes, judgments) are
# left out, as the TypeScript engine leaves them out of a run without
# them.
module Nukadoko
  module Engine
    module Summary
      MARKER: ::String

      # A failed scenario is its cell, and a row with no required cell is
      # its reason line, so the findings list leaves those out.
      TABLE_CODES: untyped

      RED: untyped

      VALUE_TEXT_LIMIT: ::Integer

      STDOUT_JSON_LIMIT: ::Integer

      ANSI: ::Regexp

      THROW_LOCATION: ::Regexp

      CARETS: ::Regexp

      CLAIMS_LEAD: ::String

      LATE_NOTE: ::String

      CONTROL_NOTE: ::String

      LIMIT_KINDS: untyped

      LIMIT_HEADINGS: untyped

      # : (Hash[Symbol, untyped]) -> String
      def self?.render: (Hash[Symbol, untyped]) -> String

      # Text outside a code span: `\` doubled first, so the `\` before a
      # `|` survives both the table parser and the inline one, and `<`
      # never opens a tag.
      # : (untyped) -> String
      def self?.cell_text: (untyped) -> String

      # A code span longer than any backtick run inside it.
      # : (untyped) -> String
      def self?.code_span: (untyped) -> String

      # : (untyped) -> String
      def self?.cell_code: (untyped) -> String

      # : (Integer, String, String) -> String
      def self?.count_of: (Integer, String, String) -> String

      # : (Integer) -> String
      def self?.duration: (Integer) -> String

      # : (untyped) -> String
      def self?.value_text: (untyped) -> String

      # The first line with text in it; a Node throw location with its
      # source line and carets is skipped, and a line that ends in a colon
      # takes the next line after it.
      # : (untyped, ?bool) -> String?
      def self?.first_visible_line: (untyped, ?bool) -> String?

      # : (untyped) -> String
      def self?.first_error_line: (untyped) -> String

      # : (Hash[Symbol, untyped]) -> String
      def self?.cell_word: (Hash[Symbol, untyped]) -> String

      # : (Hash[Symbol, untyped]) -> Array[Hash[Symbol, untyped]]
      def self?.head_scenarios: (Hash[Symbol, untyped]) -> Array[Hash[Symbol, untyped]]

      # : (Hash[untyped, untyped]) -> String
      def self?.conditions_text: (Hash[untyped, untyped]) -> String

      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.title: (Hash[Symbol, untyped]) -> Array[String]

      # : (Hash[Symbol, untyped]) -> String
      def self?.table_cell: (Hash[Symbol, untyped]) -> String

      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.table: (Hash[Symbol, untyped]) -> Array[String]

      # The line above the table under `--base`: what the run compared with,
      # how many criteria changed, and whether the mapping changed and what
      # in it, since an unchanged criterion over a changed mapping is what
      # the old world was run for.
      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.base_line: (Hash[Symbol, untyped]) -> Array[String]

      # Each criterion the base holds and head does not, with its sentences
      # at the base, so a reader approving the change sees what it drops.
      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.removed: (Hash[Symbol, untyped]) -> Array[String]

      # A capture taken at least this long after its reading says so beside
      # its link: a page that changes on a timer of a few hundred
      # milliseconds can show another state by then.
      LATE_VIEW_MS: ::Integer

      # Where a Then's judged moment can be seen: each open page's view
      # right after the reading its claims were judged on, its screenshot
      # before its ARIA snapshot, or, for a Then that read no page, the
      # requests its own step sent. Each link is [label, href, after_ms].
      # : (Hash[Symbol, untyped]) -> Array[Array[untyped]]
      def self?.seen_links: (Hash[Symbol, untyped]) -> Array[Array[untyped]]

      # : (String, String) -> String
      def self?.markdown_link: (String, String) -> String

      # : (Array[Array[untyped]]) -> String
      def self?.seen_text: (Array[Array[untyped]]) -> String

      # : (Hash[Symbol, untyped]) -> (^(Hash[Symbol, untyped]) -> String)?
      def self?.seen_column: (Hash[Symbol, untyped]) -> (^(Hash[Symbol, untyped]) -> String)?

      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.reasons: (Hash[Symbol, untyped]) -> Array[String]

      # Where an execution stopped: the step, the error's first line, the
      # producers that exited nonzero, the last command that did, the
      # record, and where the Then can be seen.
      # : (Hash[Symbol, untyped]) -> String?
      def self?.describe_failure: (Hash[Symbol, untyped]) -> String?

      # : (Array[Hash[Symbol, untyped]]?) -> Array[[untyped, Integer, String]]
      def self?.exited_producers: (Array[Hash[Symbol, untyped]]?) -> Array[[ untyped, Integer, String ]]

      # : (String) -> String?
      def self?.stdout_line: (String) -> String?

      # The gaps a green verdict does not cover, computed again from
      # run.json's other fields, never read from a stored list.
      # : (Hash[Symbol, untyped]) -> Array[Hash[Symbol, untyped]]
      def self?.limits: (Hash[Symbol, untyped]) -> Array[Hash[Symbol, untyped]]

      # One entry per row a judgment holds green: nukadoko checked that the
      # value is the one judged, and nothing of the judgment itself. A value
      # judged as an ARIA snapshot names what that leaves out: a change only
      # to how the page looks keeps the snapshot, and so the judgment.
      # : (Array[Hash[Symbol, untyped]]) -> Array[Hash[Symbol, untyped]]
      def self?.judgment_limits: (Array[Hash[Symbol, untyped]]) -> Array[Hash[Symbol, untyped]]

      # How many unmeasured actions one entry names before it counts the rest.
      UNMEASURED_SHOWN: ::Integer

      # Per step: what it did that nukadoko saw and could not measure
      # (`observed.unmeasured`), and what reached its files after its record
      # was written. Under `--repeat` the same step with the same gap is one
      # entry, citing its first record.
      # : (Array[Hash[Symbol, untyped]]) -> Array[Hash[Symbol, untyped]]
      def self?.step_limits: (Array[Hash[Symbol, untyped]]) -> Array[Hash[Symbol, untyped]]

      # What of a step's failures underneath could not be seen: its cell
      # was judged without them.
      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.unjudged_failures: (Hash[Symbol, untyped]) -> Array[String]

      # What reached a step's own files after its record was written: this
      # is the one place that says those lines exist, and names their file.
      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.late_items: (Hash[Symbol, untyped]) -> Array[String]

      # Once per world, what of the program's log and execution events no
      # step's record holds. A head step's late lines are its own entry, so
      # the world names its late count only when it is the pattern a program
      # that buffers its output on a pipe makes, or when the world is the
      # base's or the old one.
      # : (Hash[Symbol, untyped]) -> Array[Hash[Symbol, untyped]]
      def self?.world_limits: (Hash[Symbol, untyped]) -> Array[Hash[Symbol, untyped]]

      # : (Hash[Symbol, untyped], Array[Hash[Symbol, untyped]]) -> Hash[Symbol, untyped]?
      def self?.control_limit: (Hash[Symbol, untyped], Array[Hash[Symbol, untyped]]) -> Hash[Symbol, untyped]?

      # : (Hash[Symbol, untyped]) -> String
      def self?.closer_text: (Hash[Symbol, untyped]) -> String

      # : (Hash[Symbol, untyped], bool) -> String
      def self?.limit_place: (Hash[Symbol, untyped], bool) -> String

      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.limits_section: (Hash[Symbol, untyped]) -> Array[String]

      # : (Array[String]) -> String
      def self?.tag_flags: (Array[String]) -> String

      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.condition: (Hash[Symbol, untyped]) -> Array[String]

      # The claim as ClaimLine writes it, then where its values were
      # measured: a value no recorded channel holds is what a constant in
      # step code looks like, so the line says `measured: none`.
      # : (Hash[Symbol, untyped], String?) -> String
      def self?.claim_line: (Hash[Symbol, untyped], String?) -> String

      # A claim on a count of execution events the world's stop judged
      # otherwise was judged on lines still on their way: its line says what
      # the whole count came to, since its outcome proves nothing.
      # : (Hash[Symbol, untyped]) -> String
      def self?.after_world_stop_text: (Hash[Symbol, untyped]) -> String

      # : (Hash[Symbol, untyped], String?) -> String
      def self?.measured_text: (Hash[Symbol, untyped], String?) -> String

      # : (Hash[Symbol, untyped]?, String?) -> String
      def self?.channel_text: (Hash[Symbol, untyped]?, String?) -> String

      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.claims: (Hash[Symbol, untyped]) -> Array[String]

      FLAG_VERDICTS: untyped

      # How many criteria one pair of sides lists before it counts the rest.
      PATHS_SHOWN: ::Integer

      # Each kind of a path in words, one and many, in PATH_KINDS order.
      PATH_KIND_WORDS: untyped

      # A criterion's results, from the one that says most to the one that
      # says least, with their words in a count line.
      PATH_RESULTS: untyped

      # Against the base, the groups a listed criterion falls in, in the
      # order they are listed: what nothing in the feature files accounts
      # for first, since a refactor must have none and a reader is sent
      # there; then what a person approves new sentences for; then what may
      # still read the same.
      BASE_GROUPS: untyped

      BASE_GROUP_UNDECLARED: ::String

      # The words of a row's result, as the intent's readers use them.
      INTENT_RESULTS: untyped

      # : (untyped) -> String
      def self?.program_code: (untyped) -> String

      # : (String) -> String
      def self?.kind_words: (String) -> String

      # A difference's key, as events/path.rb reads one.
      # : (Hash[Symbol, untyped]) -> Hash[String, untyped]
      def self?.difference_key: (Hash[Symbol, untyped]) -> Hash[String, untyped]

      # : (Hash[String, untyped], String) -> String
      def self?.own_field_text: (Hash[String, untyped], String) -> String

      # What one entry of a path is, the program's own words in code spans.
      # : (Hash[String, untyped]) -> String
      def self?.path_entry_text: (Hash[String, untyped]) -> String

      # : (Hash[Symbol, untyped]) -> String
      def self?.range_words: (Hash[Symbol, untyped]) -> String

      # A flag compares as seen or not, so its range reads as whether the
      # program evaluated it.
      # : (Hash[Symbol, untyped]) -> String
      def self?.seen_words: (Hash[Symbol, untyped]) -> String

      # : (Hash[Symbol, untyped]) -> String
      def self?.difference_text: (Hash[Symbol, untyped]) -> String

      # Against the base, the intent row that declares a difference.
      # : (Hash[Symbol, untyped]) -> String
      def self?.intent_text: (Hash[Symbol, untyped]) -> String

      # A writer's own value that changed reads as one difference: the
      # fields that stayed, then the one that changed, old then new, when
      # exactly one entry went, one came, as many as went, and they differ
      # in one field.
      # : (Array[Hash[Symbol, untyped]]) -> Array[String]
      def self?.own_texts: (Array[Hash[Symbol, untyped]]) -> Array[String]

      # A route whose status changed, and a flag whose side did, read as one
      # difference, what it is then the old value and the new, when every
      # count on it is exact and as many went as came.
      # : (Array[Hash[Symbol, untyped]], ^(Hash[Symbol, untyped]) -> String, ^(Hash[Symbol, untyped]) -> String, ^(Hash[Symbol, untyped]) -> String) -> Array[String]
      def self?.switch_texts: (Array[Hash[Symbol, untyped]], ^(Hash[Symbol, untyped]) -> String, ^(Hash[Symbol, untyped]) -> String, ^(Hash[Symbol, untyped]) -> String) -> Array[String]

      # : (Array[Hash[Symbol, untyped]]) -> Array[String]
      def self?.kind_texts: (Array[Hash[Symbol, untyped]]) -> Array[String]

      # : (String, String) -> Integer
      def self?.by_kind: (String, String) -> Integer

      # The differences of one step by kind, in rank order.
      # : (Array[Hash[Symbol, untyped]]) -> String
      def self?.differences_text: (Array[Hash[Symbol, untyped]]) -> String

      # : (Array[Hash[Symbol, untyped]]) -> String
      def self?.gap_list: (Array[Hash[Symbol, untyped]]) -> String

      # Who leaves an open difference open: the sides that are not whole,
      # or lines on a whole side that may be any line.
      # : (Hash[Symbol, untyped], ^(Symbol) -> String) -> String
      def self?.open_why: (Hash[Symbol, untyped], ^(Symbol) -> String) -> String

      # : (Array[Integer?]) -> String
      def self?.line_words: (Array[Integer?]) -> String

      # How a comparison names its sides, and which kinds it compares.
      # : (Hash[Symbol, untyped], Hash[String, Hash[Symbol, untyped]]) -> Hash[Symbol, untyped]
      def self?.path_reading: (Hash[Symbol, untyped], Hash[String, Hash[Symbol, untyped]]) -> Hash[Symbol, untyped]

      # What the steps that ran on one side only did there, counted by kind.
      # : (Hash[Symbol, untyped], Hash[Symbol, untyped], Array[Hash[Symbol, untyped]], Symbol) -> Hash[String, Integer]
      def self?.one_side_kinds: (Hash[Symbol, untyped], Hash[Symbol, untyped], Array[Hash[Symbol, untyped]], Symbol) -> Hash[String, Integer]

      # A criterion's step lines, of the differences `marked` picks out:
      # those on a marked table, or every other.
      # : (Hash[Symbol, untyped], Hash[Symbol, untyped], bool) -> Array[String]
      def self?.step_lines: (Hash[Symbol, untyped], Hash[Symbol, untyped], bool) -> Array[String]

      # : (Hash[Symbol, untyped], Hash[Symbol, untyped]) -> Array[String]
      def self?.criterion_lines: (Hash[Symbol, untyped], Hash[Symbol, untyped]) -> Array[String]

      # A criterion whose open counts read the same on both sides, in one
      # line: the gap words that leave them open, which both sides share.
      # : (Hash[Symbol, untyped]) -> String
      def self?.same_so_far_text: (Hash[Symbol, untyped]) -> String

      # A criterion ranks by the highest kind among its decided differences
      # and what its one-side steps did, so what persists outside the
      # process comes first.
      # : (Hash[Symbol, untyped], Hash[Symbol, untyped]) -> Integer
      def self?.path_rank: (Hash[Symbol, untyped], Hash[Symbol, untyped]) -> Integer

      # : (untyped) -> String
      def self?.condition_value: (untyped) -> String

      # : (Hash[Symbol, untyped]) -> String
      def self?.path_heading: (Hash[Symbol, untyped]) -> String

      # : (String) -> Integer
      def self?.result_rank: (String) -> Integer

      # : (Hash[Symbol, untyped]) -> Integer
      def self?.base_group: (Hash[Symbol, untyped]) -> Integer

      # : (Array[String]) -> String
      def self?.path_results_said: (Array[String]) -> String

      # Against the base, what the unchanged criteria came to, each once,
      # as what it came to where it says most.
      # : (Array[Hash[Symbol, untyped]], Hash[String, untyped]) -> Array[String]
      def self?.unchanged_line: (Array[Hash[Symbol, untyped]], Hash[String, untyped]) -> Array[String]

      # The comparisons under one heading: a pair of environments alone, or
      # every environment's base pair. Each criterion counts once, as what
      # it came to where it says most, and one listed with the same lines in
      # several base pairs is listed once, naming their environments.
      # : (Hash[Symbol, untyped], Array[Hash[Symbol, untyped]]) -> Array[String]
      def self?.path_section: (Hash[Symbol, untyped], Array[Hash[Symbol, untyped]]) -> Array[String]

      # What a row declares, its cells as written.
      # : (Hash[Symbol, untyped]) -> String
      def self?.intent_row_text: (Hash[Symbol, untyped]) -> String

      # run.json's `intent`, for the person who approves the change: when it
      # was declared and whether it moved since, and what each row came to.
      # Each criterion with a difference no row declares is listed under
      # "Changed paths", so this section counts them and does not repeat
      # them.
      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.intent: (Hash[Symbol, untyped]) -> Array[String]

      # run.json's `paths`, for the person who decides whether a change may
      # be turned on for everyone: per pair of sides, each criterion whose
      # program did something else on one side than on the other, step by
      # step.
      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.paths: (Hash[Symbol, untyped]) -> Array[String]

      # At most this many routes are named in one line of "Routes"; the
      # rest are counted, and run.json's `routes` names every one.
      ROUTES_NAMED: ::Integer

      # A flag's name, side, and gate are the program's text: a line break
      # in one would end the list item, so control characters are escaped.
      # : (String) -> String
      def self?.program_word: (String) -> String

      # : (Hash[Symbol, untyped]) -> Array[Hash[Symbol, untyped]]
      def self?.head_worlds: (Hash[Symbol, untyped]) -> Array[Hash[Symbol, untyped]]

      # One line per flag and side of run.json's `flags`: its counts, and
      # the gates its lines named, or that no criterion evaluated a side the
      # flags list declares. A world whose flags list was not read is named,
      # so a missing side is never read as one the program does not have.
      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.flags: (Hash[Symbol, untyped]) -> Array[String]

      # : (Hash[Symbol, untyped]) -> String
      def self?.route_name: (Hash[Symbol, untyped]) -> String

      # : (Array[String]) -> String
      def self?.named_list: (Array[String]) -> String

      # The places of run.json's `routes` no step reached: the listed routes
      # no head step requested, split from those whose handler a request
      # reached through another route, then the requests the lists do not
      # account for. A world whose list was not read is named.
      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.routes: (Hash[Symbol, untyped]) -> Array[String]

      # : (Hash[Symbol, untyped]) -> String
      def self?.where_of: (Hash[Symbol, untyped]) -> String

      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.findings: (Hash[Symbol, untyped]) -> Array[String]

      # The heading names what the commands under it rerun: a stopped walk
      # did not fail, so a heading that called it failed would state
      # something false.
      # : (Hash[Symbol, untyped]) -> Array[String]
      def self?.rerun: (Hash[Symbol, untyped]) -> Array[String]

      # A walk is a run that paused after each step for an answer: its
      # verdicts were measured, but between steps the world and the browser
      # were open to anything, which no record covers. The longest pause
      # says how long that was.
      # : (Hash[Symbol, untyped]) -> String
      def self?.walk_sentence: (Hash[Symbol, untyped]) -> String
    end
  end
end
