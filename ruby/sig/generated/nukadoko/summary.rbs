      def self?.measured_text: (untyped claim, untyped own) -> untyped

      def self?.channel_text: (untyped measured, untyped own) -> untyped

      def self?.claims: (untyped doc) -> untyped

      def self?.where_of: (untyped finding) -> untyped

      def self?.findings: (untyped doc) -> untyped

      def self?.rerun: (untyped doc) -> untyped
