                    | (json: Hash[Symbol, untyped], step_records: Hash[String, Hash[String, untyped]?], feature: Feature, pickle: Hash[String, untyped], verdict: Hash[Symbol, untyped]?) -> instance

        def self.members: () -> [ :json, :step_records, :feature, :pickle, :verdict ]

