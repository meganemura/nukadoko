                    | (path: String, source: String, document: Hash[String, untyped], pickles: Array[Hash[String, untyped]]) -> instance

        def self.members: () -> [ :path, :source, :document, :pickles ]

        def members: () -> [ :path, :source, :document, :pickles ]
      end

