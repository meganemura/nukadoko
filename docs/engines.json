    "report": { "ruby": ["--format","--json","--out"], "typescript": ["--format","--json","--out"] },
    "verdict": { "ruby": ["--json","--trailer"], "typescript": ["--json","--trailer"] },
    "judge": { "ruby": ["--because","--by","--json","--meets","--misses","--run"], "typescript": ["--because","--by","--json","--meets","--misses","--run"] },
    "steps": { "ruby": ["--json"], "typescript": ["--json"] },
    "describe": { "ruby": [], "typescript": [] },
    "do": { "ruby": ["--args","--env","--use"], "typescript": ["--args","--env","--use"] },
