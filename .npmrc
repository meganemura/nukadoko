# A dependency's own install scripts do not run here. The npm supply-chain
# compromises of 2026 all reached a machine the same way: a `preinstall` or
# `postinstall` hook in a package nobody chose directly, executing before
# anyone had read a line of it. Turning them off costs this project nothing,
# because no dependency it has needs one (esbuild's is the only one, and it
# is not required for esbuild to work here).
#
# This also disables npm's own pre/post lifecycle hooks, which is why every
# script in package.json that needs a build calls `npm run build` in its own
# body instead of relying on `pretest`. A build step that silently does not
# run is worse than no build step.
ignore-scripts=true

# No version published less than a week ago is installed. A compromised
# release is usually found and pulled within days, so waiting is most of the
# protection available without a registry proxy. This is the same rule this
# project already applied by hand when adding a dependency.
min-release-age=7

# The one exception to the week above: @meganemura/depug is this
# repository owner's own package, published from the same machine that
# reviews it, so the wait that catches a third party's compromised release
# has nothing to catch. Listed here, not only in the machine's own config,
# because CI's `npm ci` reads this file and would otherwise refuse a
# version younger than a week.
min-release-age-exclude=@meganemura/depug
