node_modules/
dist/
.nukadoko/
tests/.tmp-fixtures/
.env
.env.*
!.env.example
# Fixture env files are test data, not real secrets; without this negation
# the .env.* rule above silently eats them and a fresh clone fails tests.
# Copies under tests/.tmp-fixtures/ stay ignored (that whole directory is),
# which is what keeps them classified as secret sources in tests.
!tests/fixtures/**/.env.*
.claude-team/
# Regenerated by selftest-suite/features/steps/allure-report.ts's own Given
# step on every run (a real `nuka init`, copied out of a disposable temp
# dir) so it always matches src/report/allure/categories.ts's current
# NAME_BY_KIND; never hand-edited, never committed.
selftest-suite/fixture-project/allurerc.mjs
# The same step's own disposable `nuka init` target directory (always
# removed in a `finally`; ignored too as a defense against a leftover one
# after a crashed run).
selftest-suite/.tmp-init-*/
# selftest-suite/features/steps/acceptance-lifecycle.ts's own disposable
# per-scenario project directory (a real, isolated git repo `nuka accept`
# needs -- always removed in an `After` hook; ignored too as a defense
# against a leftover one after a crashed run).
selftest-suite/.tmp-accept-*/
# selftest-suite/features/steps/same-scenario-across-runs.ts's own
# disposable per-scenario project directory (a real `nuka init`, run fresh
# so its own allurerc.mjs's historyPath starts empty -- always removed in
# an `After` hook; ignored too as a defense against a leftover one after a
# crashed run).
selftest-suite/.tmp-same-scenario-*/

# Coverage output: regenerated by `npm run coverage`, never committed.
coverage/

# Playwright's own default output directory. The suite's browser-using
# tests create it at the repository root on every `npm test`, empty, and
# it is regenerated rather than kept.
test-results/
