# Same policy as the repository root's .npmrc, and the same reason: a
# dependency's install script should not run before anyone has read it, and
# a version less than a week old has not yet had time for a compromised
# release to be found and pulled. This is a separate npm project (no
# workspaces), so it needs its own copy rather than inheriting the root's.
ignore-scripts=true
min-release-age=7
