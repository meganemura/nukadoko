{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  // tests/fixtures/** are raw text fed to tree-sitter, never a module any
  // test imports -- some deliberately reference a module that doesn't
  // exist (tests/extraction/step-extraction.test.ts's "wrong import source"
  // cases), which tsc would otherwise fail the whole build over.
  "exclude": ["tests/fixtures/**"]
}
