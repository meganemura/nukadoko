            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The email the token confirmed"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "register",
      "patterns": [
        "a registration for {email:string} with password {password:string} is submitted"
      ],
      "description": "Submit a registration; returns the outcome, never throws on refusal",
      "mutates": true,
      "needs": [
        "store"
      ],
      "needs_browser": false,
      "args": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The email registered"
          },
          "password": {
            "type": "string",
            "description": "The password chosen"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "returns": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "accepted",
              "refused"
            ],
            "description": "Whether the registration was accepted or refused"
          },
          "token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The confirmation token issued, when accepted"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why it was refused, when refused"
          }
        },
        "required": [
          "outcome",
          "token",
          "reason"
        ],
        "additionalProperties": false
      }
    },
