              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The confirmation token issued, when accepted"
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      },
      "returns": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
