      "name": "confirm",
      "patterns": [
        "the confirmation link is opened"
      ],
      "description": "Open the confirmation link the registration issued",
      "mutates": true,
      "from": {
        "token": {
          "step": "register",
          "key": "token"
        }
      },
      "needs": [
        "store"
      ],
