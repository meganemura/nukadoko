{
  "serve": { "command": "node server.mjs {port} {events}", "ready": "/up" },
  "lists": { "tables": "node lists.mjs" },
  "environments": {
    "reorder-off": { "conditions": { "quick_reorder": false }, "env": { "QUICK_REORDER": "{condition.quick_reorder}" } },
    "reorder-on": { "conditions": { "quick_reorder": true }, "env": { "QUICK_REORDER": "{condition.quick_reorder}" } }
  }
}
